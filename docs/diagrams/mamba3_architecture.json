      "dot": "cyan",
      "title": "Complex SSD",
      "items": [
        "A_log = softplus(dt) \u00d7 A; chunk length 64.",
        "Within-chunk and cross-chunk contributions sum to the output.",
        "64 complex64 entries = 128 float32 entries in bytes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Residuals and mixing",
      "items": [
        "Two residual additions per block; no causal convolution.",
        "MIMO mixes all 1024 flattened head channels.",
        "Identity initialization is preserved by the model initializer."
      ]
    },
    {
      "dot": "violet",
      "title": "Actual output contract",
      "items": [
        "28 blocks; tied embedding/head; approximately 434M parameters.",
        "Forward materializes [B,T,50257] logits.",
        "Training uses ordinary cross-entropy, not chunked CE."
